# Copy to .env and fill in real values for local development.
# `.env` is read by SvelteKit `$env/dynamic/private` (`npm run dev` / `npm run preview`)
# and by `wrangler dev`. Set the same keys in production with: wrangler secret put <NAME>
RAKUTEN_APPLICATION_ID=""
RAKUTEN_ACCESS_KEY=""
RAKUTEN_AFFILIATE_ID=""
VALUECOMMERCE_SID=""
VALUECOMMERCE_PID_KINOKUNIYA=""
VALUECOMMERCE_PID_HONTO=""

# oc-api の /v1/admin/cover(外部書影入りの表紙 JSON)を呼ぶ鍵。他の Worker と同じ値。
# 未設定なら /api/v1/cover は公開 /v1/cover(生成画像のみ)に落ちる。
ADMIN_API_KEY=""
